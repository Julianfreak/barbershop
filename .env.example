# ──────────────────────────────────────────────
# Variables de entorno — BuzzCut BarberShop
# Copia este archivo como .env y reemplaza los valores:
#   cp .env.example .env
# ──────────────────────────────────────────────

# Entorno de la aplicación
APP_ENV=development
APP_DEBUG=true

# Puerto expuesto en el host para la aplicación web
APP_PORT=8888

# Base de datos MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=buzzcut
DB_USER=root
DB_PASSWORD=cambia_esta_contraseña

# Puerto expuesto en el host para MySQL
DB_EXTERNAL_PORT=3307

# Contraseña root de MySQL (necesaria para inicializar el contenedor)
MYSQL_ROOT_PASSWORD=cambia_esta_contraseña
MYSQL_DATABASE=buzzcut
